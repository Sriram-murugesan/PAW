{
  "name": "paw-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "dev:browser": "vite --mode harness",
    "types": "cd ../backend && uv run python ../scripts/openapi.py > ../desktop/openapi.json && cd ../desktop && openapi-typescript openapi.json -o src/types/api.ts && rm openapi.json",
    "app:build": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol",
    "app:smoke": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features smoke,tauri/custom-protocol && python3 -I smoke/run.py && npm run app:build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
